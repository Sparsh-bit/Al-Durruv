{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--directory",
        "backend",
        "uvicorn",
        "app.main:app",
        "--port",
        "8000",
        "--reload",
        "--reload-dir",
        "app",
        "--timeout-graceful-shutdown",
        "5"
      ],
      "port": 8000
    },
    {
      "name": "api-local",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "DATABASE_URL=postgresql+psycopg://trade:trade@localhost:5433/mig_check",
        "DATABASE_URL_UNPOOLED=",
        "COMTRADE_SUBSCRIPTION_KEY=",
        "ANTHROPIC_API_KEY=",
        "uv",
        "run",
        "--directory",
        "backend",
        "uvicorn",
        "app.main:app",
        "--port",
        "8000",
        "--reload",
        "--reload-dir",
        "app",
        "--timeout-graceful-shutdown",
        "5"
      ],
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 5173
    }
  ]
}
