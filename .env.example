# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql+psycopg://trade:trade@localhost:5433/trade_intel
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173

# First admin account (created by `uv run python -m app.seed`)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Claude (https://console.anthropic.com → API Keys). AI features are disabled when empty.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
RESEARCH_MAX_SEARCHES=5

# UN Comtrade (optional). Empty = free public preview API.
COMTRADE_SUBSCRIPTION_KEY=

# ISO3 code of the exporter's country (e.g. ARE, IND, TUR). Enables "your country's share".
HOME_COUNTRY_ISO3=
